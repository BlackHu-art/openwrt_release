+-- Query parsers already decoded these values; reject non-scalar values only
+-- when consumed, as UrlDecode did before, without decoding a second time.
+local function decodedQueryValue(value)
+	if value ~= nil and type(value) ~= "string" then
+		error("invalid non-string transport query value")
+	end
+	return value
