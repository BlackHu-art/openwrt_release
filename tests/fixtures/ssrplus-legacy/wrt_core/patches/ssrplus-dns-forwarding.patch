 add_dns_into_ipset() {
 	[ "${SSRP_PREPARE_ONLY:-0}" != 1 ] || return 0
+	if [ "$USE_TABLES" = "nftables" ]; then
+		# GFW needs the resolver before DNS can populate its destination set.
+		# This master baseline has only IPv4 sets/rules; never truncate IPv6.
+		[ "$1" = "gfw" ] || return 0
+		local resolver="${2##*/}"
+		resolver="${resolver%:*}"
+		case "$resolver" in *:*) return 0 ;; esac
+		ssrp_valid_ip "$resolver" || return 0
+		# DNS preflight and startup before rule activation must stay read-only.
+		nft list set inet ss_spec gfwlist 2>/dev/null | grep -q 'type ipv4_addr' || return 0
+		nft add element inet ss_spec gfwlist "{ $resolver }" 2>/dev/null
+		return $?
+	fi
+	[ "$USE_TABLES" = "iptables" ] && [ "$HAS_IPSET" -eq 1 ] || return 0
 	case "$1" in
 	gfw) ipset add gfwlist ${2%:*} 2>/dev/null ;;
 	oversea) ipset add oversea ${2%:*} 2>/dev/null ;;
 	*) ipset add ss_spec_wan_ac ${2%:*} nomatch 2>/dev/null ;;
 	esac
+	# Existing ipset members were historically non-fatal during DNS startup.
+	return 0
 }
 
