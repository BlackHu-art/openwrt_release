+snapshot_has_only_ssr_tables() {
+	awk '
+		function bad() { failed = 1; exit 1 }
+		{
+			line = $0
+			if (depth == 0) {
+				if (line ~ /^[ \t]*(#.*)?$/) next
+				if (line ~ /^table inet ss_spec[ \t]*\{[ \t]*$/) {
+					if (inet++) bad()
+				} else if (line ~ /^table ip ss_spec_mangle[ \t]*\{[ \t]*$/) {
+					if (mangle++) bad()
+				} else bad()
+			}
+			quoted = 0; escaped = 0
+			for (i = 1; i <= length(line); i++) {
+				c = substr(line, i, 1)
+				if (quoted) {
+					if (escaped) escaped = 0
+					else if (c == "\\") escaped = 1
+					else if (c == "\"") quoted = 0
+					continue
+				}
+				if (c == "#") break
+				if (c == "\"") { quoted = 1; continue }
+				if (substr(line, i) ~ /^include([ \t]|$)/ &&
+					(i == 1 || substr(line, i - 1, 1) !~ /[[:alnum:]_]/)) bad()
+				if (c == "{") depth++
+				if (c == "}") {
+					depth--
+					if (depth < 0) bad()
+					if (depth == 0 && substr(line, i + 1) !~ /^[ \t]*(#.*)?$/) bad()
+				}
+			}
+			if (quoted) bad()
+		}
+		END { if (failed || depth != 0 || !(inet || mangle)) exit 1 }
+	' "$1"
