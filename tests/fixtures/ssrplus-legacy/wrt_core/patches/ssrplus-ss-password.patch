Subject: SSR Plus preserve literal native SS passwords after Base64 decoding

The Base64 payload already contains method:password. Percent-looking bytes in
the password are literal, not an extra URI encoding layer. Keep outer URI
decoding and existing configuration untouched.

diff --git a/root/usr/share/shadowsocksr/subscribe.lua b/root/usr/share/shadowsocksr/subscribe.lua
--- a/root/usr/share/shadowsocksr/subscribe.lua
+++ b/root/usr/share/shadowsocksr/subscribe.lua
@@ -897,19 +897,7 @@
 			method = userinfo:sub(1, meth_pass - 1)
 			password = userinfo:sub(meth_pass + 1)
 
-			-- 判断密码是否经过url编码
-			local function isURLEncodedPassword(pwd)
-				if not pwd:find("%%[0-9A-Fa-f][0-9A-Fa-f]") then
-					return false
-				end
-				local ok, decoded = pcall(UrlDecode, pwd)
-				return ok and urlEncode(decoded) == pwd
-			end
-
-			local decoded = UrlDecode(password)
-			if isURLEncodedPassword(password) and decoded then
-				password = decoded
-			end
+			-- Base64 already contains the literal password; do not guess URI encoding.
 
 			-- 解析服务器地址和端口（兼容 IPv6）
 			if host_port:find("^%[.*%]:%d+$") then
