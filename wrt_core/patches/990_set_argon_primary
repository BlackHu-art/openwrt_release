#!/bin/sh

[ -e /etc/config/argon ] || touch /etc/config/argon || exit 1
if ! uci -q get 'argon.@global[0]' >/dev/null 2>&1; then
    uci -q add argon global >/dev/null || exit 1
fi

uci -q get 'argon.@global[0].primary' >/dev/null 2>&1 ||
    uci set 'argon.@global[0].primary=#6A89CC'
uci -q get 'argon.@global[0].transparency' >/dev/null 2>&1 ||
    uci set 'argon.@global[0].transparency=0.3'
uci commit argon
