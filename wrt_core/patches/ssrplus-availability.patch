+# Private preflight does not spawn cores, mutate firewall state, or publish DNS.
+# JSON syntax and dnsmasq validation catch generation errors before stopping.
+ssrp_preflight() (
+    SSRP_PREPARE_ONLY=1
+    ssrp_dns_begin || exit 1
+    trap 'ssrp_dns_abort' EXIT
+    TMP_PATH="$SSRP_DNS_STAGE/ssrplus"
+    TMP_BIN_PATH="$TMP_PATH/bin"
+    mkdir -p "$TMP_PATH" "$TMP_BIN_PATH" || exit 1
+    check_run_environment
+    if load_config; then
+        local node configuration
+        for node in "$GLOBAL_SERVER" "$UDP_RELAY_SERVER" "$SHUNT_SERVER" "$LOCAL_SERVER"; do
+            case "$node" in ''|nil|same) continue ;; esac
+            get_host_ip "$node" >/dev/null || exit 1
+        done
+        Start_Run || exit 1
+        SSRP_DNS_STAGE="$TMP_DNSMASQ_PATH" /usr/share/shadowsocksr/gfw2ipset.sh || exit 1
+        start_dns || exit 1
+    else
+        case "$LOCAL_SERVER" in
+            ''|nil|same) ;;
+            *) get_host_ip "$LOCAL_SERVER" >/dev/null || exit 1 ;;
+        esac
+        sed -e '/^$/d' -e '/#/d' -e 's|.*|address=/&/|' /etc/ssrplus/deny.list > "$TMP_DNSMASQ_PATH/denylist.conf" || exit 1
+        if [ "$(uci_get_by_type global adblock 0)" = 1 ]; then
+            cp /etc/ssrplus/ad.conf "$TMP_DNSMASQ_PATH/ad.conf" || exit 1
+        fi
+    fi
+    for configuration in "$TMP_PATH"/*.json; do
+        [ -f "$configuration" ] || continue
+        if [ -f "$TMP_PATH/.non-json-configs" ] && grep -qxF "$configuration" "$TMP_PATH/.non-json-configs"; then
+            continue
+        fi
+        jq -e . "$configuration" >/dev/null || exit 1
+    done
+    ssrp_dns_validate
+)
+
