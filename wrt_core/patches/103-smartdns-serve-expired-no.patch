From 1006f640d50f1e2951e13d3e740813cc76a6739e Mon Sep 17 00:00:00 2001
Subject: [PATCH] fix global config `serve-expired no` not work

Origin: https://github.com/pymumu/smartdns/commit/1006f640d50f1e2951e13d3e740813cc76a6739e
Respect the global/group policy when serving stale cache and selecting the
reply TTL. Keep existing defaults and configuration generation unchanged.
Backported to pinned core 136c0c2690138d6dedd8b520281aafe49112643f.

Downstream review follow-up: before a dualstack SOA shortcut, fall back
to the ordinary cache path if stale serving is forbidden and either cache
entry is expired. This prevents bypassing the upstream policy check.

--- a/src/dns_server/cache.c
+++ b/src/dns_server/cache.c
@@ -526,6 +526,11 @@
 			if ((dualstack_dns_cache->info.speed + (request->conf->dns_dualstack_ip_selection_threshold * 10)) <
 					dns_cache->info.speed ||
 				dns_cache->info.speed < 0) {
+				if ((request->no_serve_expired == 1 || request->conf->dns_serve_expired == 0) &&
+					(dns_cache_get_ttl(dns_cache) <= 0 || dns_cache_get_ttl(dualstack_dns_cache) <= 0)) {
+					goto reply_cache;
+				}
+
 				tlog(TLOG_DEBUG, "cache result: %s, qtype: %d, force %s preferred, id: %d, time1: %d, time2: %d",
 					 request->domain, request->qtype, request->qtype == DNS_T_AAAA ? "IPv4" : "IPv6", request->id,
 					 dns_cache->info.speed, dualstack_dns_cache->info.speed);
@@ -537,7 +542,8 @@
 	}
 
 reply_cache:
-	if (dns_cache_get_ttl(dns_cache) <= 0 && request->no_serve_expired == 1) {
+	if (dns_cache_get_ttl(dns_cache) <= 0 &&
+		(request->no_serve_expired == 1 || request->conf->dns_serve_expired == 0)) {
 		goto out;
 	}
 
--- a/src/dns_server/rules.c
+++ b/src/dns_server/rules.c
@@ -451,7 +451,7 @@
 
 	if ((request->passthrough == 0 || request->passthrough == 2) && dns_conf.cachesize > 0 &&
 		request->check_order_list->orders[0].type != DOMAIN_CHECK_NONE && request->no_serve_expired == 0 &&
-		request->has_soa == 0 && request->no_cache == 0) {
+		request->conf->dns_serve_expired == 1 && request->has_soa == 0 && request->no_cache == 0) {
 		reply_ttl = request->conf->dns_serve_expired_reply_ttl;
 		if (reply_ttl < 2) {
 			reply_ttl = 2;
