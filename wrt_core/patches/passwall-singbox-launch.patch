Subject: passwall: stop launching sing-box when config generation fails

Keep generator diagnostics in the plugin log and remove partial JSON before
returning failure, including generation-only callers.

diff --git a/root/usr/share/passwall/app.sh b/root/usr/share/passwall/app.sh
--- a/root/usr/share/passwall/app.sh
+++ b/root/usr/share/passwall/app.sh
@@ -193,7 +193,10 @@
 	[ -n "$no_run" ] && json_add_string "no_run" "1"
 	[ -n "$run_in_global" ] && json_add_string "run_in_global" "1"
 	local _json_arg="$(json_dump)"
-	lua $UTIL_SINGBOX gen_config "${_json_arg}" > $config_file
+	if ! lua "$UTIL_SINGBOX" gen_config "${_json_arg}" > "$config_file" 2>> "$LOG_FILE"; then
+		rm -f "$config_file"
+		return 1
+	fi
 	[ -n "$no_run" ] && return
 
 	local test_log_file=$log_file
