Subject: [PATCH] homeproxy: preserve supported DNS expiry and adapt sing-box 1.14

Keep disable_cache_expire mapped to dns.disable_expire, which sing-box 1.14
still supports. Retain the legacy sniff/independent-cache cleanup, sniff
timeout and resolver cleanup without changing VPN routing.

diff --git a/root/etc/homeproxy/scripts/generate_client.uc b/root/etc/homeproxy/scripts/generate_client.uc
index ce54caa..837bad2 100644
--- a/root/etc/homeproxy/scripts/generate_client.uc
+++ b/root/etc/homeproxy/scripts/generate_client.uc
@@ -429,7 +429,7 @@ config.dns = {
 	rules: [],
 	strategy: dns_default_strategy,
 	disable_cache: strToBool(dns_disable_cache),
-	disable_expire: strToBool(dns_disable_cache_expire),
+	disable_expire: strToBool(dns_disable_cache_expire), // Supported by sing-box 1.14.
 	client_subnet: dns_client_subnet
 };
 
@@ -783,7 +783,8 @@ config.route = {
 			action: 'hijack-dns'
 		},
 		{
-			action: 'sniff'
+			action: 'sniff',
+			timeout: '300ms'
 		}
 	],
 	rule_set: [],
@@ -795,7 +796,6 @@ config.route = {
 if (!isEmpty(main_node)) {
 	/* Avoid DNS loop */
 	config.route.default_domain_resolver = {
-		action: 'route',
 		server: (routing_mode === 'bypass_mainland_china') ? 'china-dns' : 'default-dns',
 		strategy: (ipv6_support !== '1') ? 'prefer_ipv4' : null
 	};
@@ -871,7 +871,6 @@ if (!isEmpty(main_node)) {
 		config.route.rule_set = null;
 } else if (!isEmpty(default_outbound)) {
 	config.route.default_domain_resolver = {
-		action: 'resolve',
 		server: get_resolver(default_outbound_dns)
 	};
 
