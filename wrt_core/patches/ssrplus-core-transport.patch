+# Check selected nodes before preflight generation or any service replacement.
+# Preserve unsupported subscriptions and explicit choices for the user to repair.
+ssrp_check_xray_transport() {
+	local node="$1" transport
+	case "$node" in ''|nil|same) return 0 ;; esac
+	[ "$(uci_get_by_name "$node" type)" = v2ray ] || return 0
+	# These protocols ignore a retained transport field in the actual generator.
+	case "$(uci_get_by_name "$node" v2ray_protocol)" in wireguard|hysteria2) return 0 ;; esac
+	transport=$(uci_get_by_name "$node" transport | tr 'A-Z' 'a-z')
+	case "$transport" in h2|h3|http|quic)
+		echolog "SSR Plus: unsupported Xray transport '$transport' in node '$node'; node and selection retained; change the remote transport explicitly"
+		return 1 ;;
+	esac
+}
+
+ssrp_check_selected_xray_transports() {
+	local main socks
+	main=${switch_server:-$(uci_get_by_type global global_server nil)}
+	ssrp_check_xray_transport "$main" || return 1
+	if [ "$(uci_get_by_type socks5_proxy enabled 0)" = 1 ]; then
+		socks=$(uci_get_by_type socks5_proxy server nil)
+		[ "$socks" != same ] || socks=$main
+		ssrp_check_xray_transport "$socks" || return 1
+	fi
+	case "$main" in ''|nil) return 0 ;; esac
+	ssrp_check_xray_transport "$(uci_get_by_type global udp_relay_server nil)" || return 1
+	if [ "$(uci_get_by_type global netflix_enable 0)" = 1 ]; then
+		ssrp_check_xray_transport "$(uci_get_by_type global netflix_server nil)" || return 1
+	fi
+}
+
 # Private preflight does not spawn cores, mutate firewall state, or publish DNS.
 # JSON syntax and dnsmasq validation catch generation errors before stopping.
 ssrp_preflight() (
+    ssrp_check_selected_xray_transports || exit 1
     SSRP_PREPARE_ONLY=1
     ssrp_dns_begin || exit 1
     trap 'ssrp_dns_abort' EXIT
