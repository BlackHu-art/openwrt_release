diff --git a/oaf/src/fwx_main.c b/oaf/src/fwx_main.c
--- a/oaf/src/fwx_main.c
+++ b/oaf/src/fwx_main.c
@@ -1245,33 +1245,24 @@ void af_feature_load_done_msg_handle(void)
 	}
 }
 
-static unsigned char *read_skb(struct sk_buff *skb, unsigned int from, unsigned int len)
+static unsigned char *read_skb(struct sk_buff *skb, int from, int len)
 {
-	struct skb_seq_state state;
 	unsigned char *msg_buf = NULL;
-	unsigned int consumed = 0;
 
-	msg_buf = kmalloc(len, GFP_KERNEL);
+	/* Validate the range without overflowing from + len. */
+	if (!skb || from < 0 || len <= 0 || from > skb->len ||
+	    len > skb->len - from)
+		return NULL;
+
+	/* Netfilter receive hooks run in softirq context. */
+	msg_buf = kmalloc(len, GFP_ATOMIC);
 	if (!msg_buf)
 		return NULL;
 
-	skb_prepare_seq_read(skb, from, from + len, &state);
-	while (1)
-	{
-		unsigned int avail;
-		const u8 *ptr;
-		avail = skb_seq_read(consumed, &ptr, &state);
-		if (avail == 0)
-		{
-			break;
-		}
-		memcpy(msg_buf + consumed, ptr, avail);
-		consumed += avail;
-		if (consumed >= len)
-		{
-			skb_abort_seq_read(&state);
-			break;
-		}
+	/* Copy exactly len bytes, including non-linear skb fragments. */
+	if (skb_copy_bits(skb, from, msg_buf, len)) {
+		kfree(msg_buf);
+		return NULL;
 	}
 	return msg_buf;
 }
@@ -1428,35 +1419,38 @@ void dpi_http_proto(flow_info_t *flow)
 
 	data = flow->l4_data;
 	data_len = flow->l4_len;
-	if (data_len < MIN_HTTP_DATA_LEN)
+	if (!data || data_len < MIN_HTTP_DATA_LEN)
 	{
 		return;
 	}
 
-	for (i = 0; i < data_len; i++)
+	for (i = 0; i < data_len - 1; i++)
 	{
 		if (data[i] == 0x0d && data[i + 1] == 0x0a)
 		{
-			if (0 == memcmp(&data[start], "POST ", 5))
+			int line_len = i - start;
+
+			if (line_len >= 5 && 0 == memcmp(&data[start], "POST ", 5))
 			{
 				flow->http.match = AF_TRUE;
 				flow->http.method = HTTP_METHOD_POST;
 				flow->http.url_pos = data + start + 5;
 				flow->http.url_len = i - start - 5;
 			}
-			else if (0 == memcmp(&data[start], "GET ", 4))
+			else if (line_len >= 4 && 0 == memcmp(&data[start], "GET ", 4))
 			{
 				flow->http.match = AF_TRUE;
 				flow->http.method = HTTP_METHOD_GET;
 				flow->http.url_pos = data + start + 4;
 				flow->http.url_len = i - start - 4;
 			}
-			else if (0 == memcmp(&data[start], "Host:", 5))
+			else if (line_len >= 6 && 0 == memcmp(&data[start], "Host:", 5))
 			{
 				flow->http.host_pos = data + start + 6;
 				flow->http.host_len = i - start - 6;
 			}
-			if (data[i + 2] == 0x0d && data[i + 3] == 0x0a)
+			if (data_len - i >= 4 &&
+			    data[i + 2] == 0x0d && data[i + 3] == 0x0a)
 			{
 				flow->http.data_pos = data + i + 4;
 				flow->http.data_len = data_len - i - 4;
@@ -2250,6 +2244,7 @@ u_int32_t fwx_hook_bypass_handle(struct sk_buff *skb, struct net_device *dev)
 	spin_lock(&af_conn_lock);
    	conn = af_conn_find_and_add(flow.src, flow.dst, flow.sport, flow.dport, flow.l4_protocol);
 	if (!conn){
+		spin_unlock(&af_conn_lock);
 		return NF_ACCEPT;
 	}
 
@@ -2279,8 +2274,10 @@ u_int32_t fwx_hook_bypass_handle(struct sk_buff *skb, struct net_device *dev)
 				return NF_ACCEPT;
 			}
 		}
-		if (skb_is_nonlinear(skb) && flow.l4_len < MAX_AF_SUPPORT_DATA_LEN)
+		if (skb_is_nonlinear(skb))
 		{
+			/* Limit both the copy and subsequent DPI reads to this prefix. */
+			flow.l4_len = min(flow.l4_len, MAX_AF_SUPPORT_DATA_LEN);
 			flow.l4_data = read_skb(skb, flow.l4_data - skb->data, flow.l4_len);
 			if (!flow.l4_data)
 				return NF_ACCEPT;
@@ -2475,8 +2472,10 @@ u_int32_t fwx_hook_gateway_handle(struct sk_buff *skb, struct net_device *dev)
 	if (total_packets > MAX_DPI_PKT_NUM)
 		return NF_ACCEPT;
 
-	if (skb_is_nonlinear(skb) && flow.l4_len < MAX_AF_SUPPORT_DATA_LEN)
+	if (skb_is_nonlinear(skb))
 	{
+		/* Limit both the copy and subsequent DPI reads to this prefix. */
+		flow.l4_len = min(flow.l4_len, MAX_AF_SUPPORT_DATA_LEN);
 		flow.l4_data = read_skb(skb, flow.l4_data - skb->data, flow.l4_len);
 		if (!flow.l4_data)
 			return NF_ACCEPT;
