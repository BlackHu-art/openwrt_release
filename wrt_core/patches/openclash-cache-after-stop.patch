# Selected from vernesong/OpenClash 2faa4fabfe1c12899feb1ddc060adda3fa7f2343.
# Preserve the stable shutdown sequence and copy only after core exit.
diff --git a/root/etc/init.d/openclash b/root/etc/init.d/openclash
index 9981959..43b4ebc 100644
--- a/root/etc/init.d/openclash
+++ b/root/etc/init.d/openclash
@@ -3954,10 +3954,12 @@ stop_service()
    get_config
 
    LOG_TIP "OpenClash Stoping..."
-   LOG_OUT "Step 1: Backup The Current Groups State..."
+   LOG_OUT "Step 1: Capture The Running Configuration..."
 
    {
-      /usr/share/openclash/openclash_history_get.sh
+      # UCI may already select a different configuration.
+      local running_config
+      running_config=$(unify_ps_cfgname)
 
       LOG_OUT "Step 2: Delete OpenClash Firewall Rules..."
       revert_firewall
@@ -3976,9 +3978,16 @@ stop_service()
       procd_send_signal "openclash-watchdog" "" TERM
       # remove only the core instance, rc.common's stop() deletes the service itself
       procd_kill "openclash" "openclash"
+      # procd may unregister the instance before the core exits.
       for i in $(seq 1 10); do
-         procd_running "openclash" >/dev/null && sleep 1 || break
+         if ! procd_running "openclash" >/dev/null && ! pidof clash >/dev/null; then
+            break
+         fi
+         sleep 1
       done
+      if [ -n "$running_config" ] && ! pidof clash >/dev/null; then
+         /usr/share/openclash/openclash_history_get.sh after_stop "$running_config"
+      fi
 
       LOG_OUT "Step 4: Restart Dnsmasq..."
       revert_dnsmasq
diff --git a/root/usr/share/openclash/openclash_history_get.sh b/root/usr/share/openclash/openclash_history_get.sh
