-   HISTORY_PATH_OLD="/etc/openclash/history/${CONFIG_NAME%.*}"
-   HISTORY_PATH="/etc/openclash/history/${CONFIG_NAME%.*}.db"
-fi
-
-if [ -n "$(pidof clash)" ] && [ -f "$CONFIG_FILE" ]; then
