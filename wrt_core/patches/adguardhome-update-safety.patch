+# Read the CLI version without parsing config-check diagnostics.
+core_version(){
+	local output
+	output=$("$1" --version 2>/dev/null) || return 1
+	printf '%s\n' "$output" | awk '
+		$1 == "AdGuard" && ($2 == "Home," || $2 == "Home") && $3 == "version" {
+			print $4; exit
+		}' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$'
+}
+
+# The target is stable; equal numeric components supersede a prerelease only.
+version_is_newer(){
+	awk -v latest="${1#v}" -v current="${2#v}" 'BEGIN {
+		split(latest, l, "."); split(current, c, ".")
+		for (i = 1; i <= 3; i++) {
+			if (l[i] + 0 > c[i] + 0) exit 0
+			if (l[i] + 0 < c[i] + 0) exit 1
+		}
+		exit (current ~ /^[0-9]+\.[0-9]+\.[0-9]+-/ ? 0 : 1)
+	}'
+}
