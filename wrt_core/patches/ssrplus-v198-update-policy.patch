+get_xray_package_version() {
+	local pm="$1" version status
+	case "$pm" in
+		opkg)
+			status="$(opkg status xray-core 2>/dev/null)"
+			printf '%s\n' "$status" | grep -q '^Status:.* installed$' || return 1
+			version="$(printf '%s\n' "$status" | sed -n 's/^Version:[[:space:]]*//p' | sed -n '1p')"
+			;;
+		apk)
+			version="$(apk list -I xray-core 2>/dev/null | sed -n 's/^xray-core-\([^[:space:]]*\).*$/\1/p' | sed -n '1p')"
+			;;
+	esac
+	[ -n "${version:-}" ] || return 1
+	printf '%s' "$version"
+}
+
+normalize_xray_package_version() {
+	# opkg records -N while APK and fw release assets may use -rN.
+	trim_version "$1" | sed 's/-r\([0-9][0-9]*\)$/-\1/'
+}
+
+xray_update_available() {
+	local latest="$1" installed_package="$2" installed_binary="$3" latest_binary
+	[ -n "$installed_binary" ] || return 0
+	if [ -n "$installed_package" ]; then
+		version_gt "$(normalize_xray_package_version "$latest")" "$(normalize_xray_package_version "$installed_package")"
+		return $?
+	fi
+	# An untracked binary has no reliable package revision. Restore package
+	# management on equal versions, but never downgrade a newer binary.
+	latest_binary="$(normalize_xray_package_version "$latest" | sed 's/-[0-9][0-9]*$//')"
+	! version_gt "$installed_binary" "$latest_binary"
+}
