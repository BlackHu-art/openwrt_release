Subject: passwall2: stop launching sing-box when config generation fails

Keep generator diagnostics in the plugin log and remove partial JSON before
returning failure, including generation-only callers.

diff --git a/root/usr/share/passwall2/app.sh b/root/usr/share/passwall2/app.sh
--- a/root/usr/share/passwall2/app.sh
+++ b/root/usr/share/passwall2/app.sh
@@ -340,7 +340,10 @@
 	json_add_string "node" "${node}"
 
 	local _json_arg="$(json_dump)"
-	lua $UTIL_SINGBOX gen_config "${_json_arg}" > $config_file
+	if ! lua "$UTIL_SINGBOX" gen_config "${_json_arg}" > "$config_file" 2>> "$LOG_FILE"; then
+		rm -f "$config_file"
+		return 1
+	fi
 
 	test_log_file=$log_file
 	[ "$test_log_file" = "/dev/null" ] && test_log_file="${TMP_PATH}/test.log"
@@ -435,7 +438,10 @@
 		json_add_string "direct_dns_${DIRECT_DNS_PROTO}_port" "${DIRECT_DNS_PORT}"
 		json_add_string "direct_dns_query_strategy" "${DIRECT_DNS_QUERY_STRATEGY}"
 		local _json_arg="$(json_dump)"
-		lua $UTIL_SINGBOX gen_config "${_json_arg}" > $config_file
+		if ! lua "$UTIL_SINGBOX" gen_config "${_json_arg}" > "$config_file" 2>> "$LOG_FILE"; then
+			rm -f "$config_file"
+			return 1
+		fi
 		[ -z "$no_run" ] && ln_run ${QUEUE_RUN} "$SINGBOX_BIN" "sing-box" /dev/null run -c "$config_file"
 	;;
 	xray)
