Subject: fix: manage the DHCP DNS option added by SmartDNS
Adapted from https://github.com/pymumu/smartdns/commit/21c940edc65520849ba03544c5cf8d9cf326e680

Avoid inserting a duplicate. Remember the exact option only when SmartDNS
adds it, so stop and reconfiguration preserve pre-existing DHCP settings.

--- a/package/openwrt/files/etc/init.d/smartdns
+++ b/package/openwrt/files/etc/init.d/smartdns
@@ -81,7 +81,7 @@
 
 set_main_dns()
 {
-	local hostip
+	local hostip dns_option previous_option
 	hostip="$(uci -q get network.lan.ipaddr | sed 's/\/.*//g')"
 	dnsmasq_port="$(uci -q get dhcp.@dnsmasq[0].port)"
 	[ -z "$dnsmasq_port" ] && dnsmasq_port="53"
@@ -91,7 +91,16 @@
 	uci_batch=""
 	[ "$dnsmasq_port" = "53" ] && {
 		uci_batch="$uci_batch set dhcp.@dnsmasq[0].port=0\n"
-		uci_batch="$uci_batch add_list dhcp.lan.dhcp_option=\"6,$hostip\"\n"
+		dns_option="6,$hostip"
+		previous_option="$(uci -q get dhcp.lan.smartdns_dhcp_option)"
+		if [ -n "$previous_option" ] && [ "$previous_option" != "$dns_option" ]; then
+			uci_batch="$uci_batch del_list dhcp.lan.dhcp_option=\"$previous_option\"\n"
+			uci_batch="$uci_batch delete dhcp.lan.smartdns_dhcp_option\n"
+		fi
+		if ! uci -q get dhcp.lan.dhcp_option | tr ' ' '\n' | grep -Fqx "$dns_option"; then
+			uci_batch="$uci_batch add_list dhcp.lan.dhcp_option=\"$dns_option\"\n"
+			uci_batch="$uci_batch set dhcp.lan.smartdns_dhcp_option=\"$dns_option\"\n"
+		fi
 	}
 
 	# for some third-party firmware
@@ -113,7 +122,7 @@
 stop_main_dns()
 {
 	local norestart="$1"
-	hostip="$(uci -q get network.lan.ipaddr)"
+	local dns_option
 	dnsmasq_port="$(uci -q get dhcp.@dnsmasq[0].port)"
 	redir_dns="$(uci -q get dhcp.@dnsmasq[0].old_dns_redirect)"
 	[ "$dnsmasq_port" != "0" ] && return
@@ -124,7 +133,12 @@
 		uci_batch="$uci_batch delete dhcp.@dnsmasq[0].old_dns_redirect\n"
 	}
 	uci_batch="$uci_batch delete dhcp.@dnsmasq[0].port\n"
-	uci_batch="$uci_batch del_list dhcp.lan.dhcp_option=\"6,$hostip\"\n"
+	# Remove only what SmartDNS inserted, using the address at insertion time.
+	dns_option="$(uci -q get dhcp.lan.smartdns_dhcp_option)"
+	if [ -n "$dns_option" ]; then
+		uci_batch="$uci_batch del_list dhcp.lan.dhcp_option=\"$dns_option\"\n"
+		uci_batch="$uci_batch delete dhcp.lan.smartdns_dhcp_option\n"
+	fi
 	echo -e "$uci_batch" | uci batch -q -
 	uci commit dhcp
 	[ "$norestart" != "1" ] && /etc/init.d/dnsmasq reload
