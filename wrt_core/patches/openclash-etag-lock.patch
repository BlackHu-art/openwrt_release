# Use the existing flock runtime to avoid stealing a live writer by age; unique PID temp files and scoped cleanup.
# Intentionally excludes its checksum hunk; the existing precise checksum patch remains authoritative.
diff --git a/root/usr/share/openclash/openclash_etag.sh b/root/usr/share/openclash/openclash_etag.sh
--- a/root/usr/share/openclash/openclash_etag.sh
+++ b/root/usr/share/openclash/openclash_etag.sh
@@ -8,13 +8,14 @@
     local path=$1
     [ ! -f "$ETAG_CACHE" ] && return 1
 
-    local path_hash=$(echo -n "$path" | md5sum | cut -d' ' -f1)
+    local path_hash=$(echo -n "$path" | md5sum)
+    path_hash=${path_hash%% *}
 
-    awk -v hash="$path_hash" '
-        $0 ~ "^\\[" hash "\\]" { found=1; next }
+    awk -v key="[$path_hash]" '
+        index($0, key) == 1 { found=1; next }
         /^\[/ { found=0 }
-        found && /^time=/ { print $0; exit }
-    ' "$ETAG_CACHE" | cut -d'=' -f2- | sed 's/^"//;s/"$//'
+        found && /^time=/ { value=$0; sub(/^time=/, "", value); gsub(/^"|"$/, "", value); print value; exit }
+    ' "$ETAG_CACHE"
 }
 
