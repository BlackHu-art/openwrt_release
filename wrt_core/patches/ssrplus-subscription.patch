+-- Reverse only this update's writes, through a fresh cursor. Full-section
+-- reversal is allowed only for sections we created/deleted and whose expected
+-- state still matches. Existing sections restore only changed option fields.
+local function rollback_subscription(before, after, global_section, old_global, new_global)
+	local recovery = subscription_cursor()
+	local ok, err = pcall(function()
+		checked(not shared_uci_changes(), "rollback conflict: shared UCI changes are pending")
+		-- Validate every touched section before staging any recovery writes.
+		for sid, old in pairs(before) do
+			local written, current = after[sid], read_section(recovery, sid)
+			if old == false or written == false then
+				checked(equal_value(current, written), "rollback conflict in node " .. sid)
+			else
+				checked(current and current[".type"] == written[".type"], "rollback conflict in node type " .. sid)
+				for key in pairs(changed_fields(old, written)) do
+					checked(equal_value(current[key], written[key]), "rollback conflict in node field " .. sid .. "." .. key)
+				end
+			end
+		end
+		if old_global ~= new_global then
+			checked(recovery:get(name, global_section) == "global" and
+				recovery:get(name, global_section, "global_server") == new_global, "rollback conflict in global_server")
+		end
+		for sid, old in pairs(before) do
+			local written = after[sid]
+			if old == false then
+				checked(recovery:delete(name, sid), "rollback delete failed: " .. sid)
+			elseif written == false then
+				checked(recovery:section(name, old[".type"], sid), "rollback recreate failed: " .. sid)
+				for key, value in pairs(old) do
+					if key:sub(1, 1) ~= "." then
+						checked(recovery:set(name, sid, key, value), "rollback restore failed: " .. sid .. "." .. key)
+					end
+				end
+			else
+				for key in pairs(changed_fields(old, written)) do
+					if old[key] == nil then
+						checked(recovery:delete(name, sid, key), "rollback option delete failed: " .. sid .. "." .. key)
+					else
+						checked(recovery:set(name, sid, key, old[key]), "rollback option restore failed: " .. sid .. "." .. key)
+					end
+				end
+			end
+		end
+		if old_global ~= new_global then
+			if old_global == nil then
+				checked(recovery:delete(name, global_section, "global_server"), "rollback global option delete failed")
+			else
+				checked(recovery:set(name, global_section, "global_server", old_global), "rollback global option restore failed")
+			end
+		end
+		checked(recovery:commit(name), "rollback commit failed")
+	end)
+	if not ok then
+		-- unload discards only this cursor's in-memory edits; revert would also
+		-- remove shared saved UCI deltas belonging to other configuration clients.
+		recovery:unload(name)
+		log("subscription rollback failed: " .. tostring(err))
+		return false
+	end
+	if not restart_service() then
+		log("subscription config restored; recovery restart failed; service state is degraded")
+		return false
+	end
+	log("previous subscription config restored; recovery restart completed")
+	return true
+end
