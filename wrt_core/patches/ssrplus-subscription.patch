+-- lockf/tlock is process-owned and released on exit; never unlink the inode.
+-- Acquire before opening the UCI cursor, so cooperating subscribers see fresh data.
+local subscription_lock = nixio.open("/var/lock/ssrplus-subscribe.lock", "a")
+if not subscription_lock then
+	print("subscription writer lock could not be opened")
+	os.exit(1)
+end
+if not subscription_lock:lock("tlock") then
+	subscription_lock:close()
+	print("subscription update already running")
+	os.exit(1)
+end
 
