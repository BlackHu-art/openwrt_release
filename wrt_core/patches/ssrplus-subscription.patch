+local function checked(result, message)
+	if not result then error(message) end
+	return result
+end
+
+-- UCI values are scalars or lists. Ignore cursor-only metadata such as .index.
+local function copy_value(value)
+	if type(value) ~= "table" then return value end
+	local result = {}
+	for key, item in pairs(value) do result[key] = copy_value(item) end
+	return result
+end
+
+local function equal_value(a, b)
+	if type(a) ~= type(b) then return false end
+	if type(a) ~= "table" then return a == b end
+	for key, value in pairs(a) do
+		if not equal_value(value, b[key]) then return false end
+	end
+	for key in pairs(b) do if a[key] == nil then return false end end
+	return true
+end
+
+local function read_section(cursor, sid)
+	local data = cursor:get_all(name, sid)
+	if not data then return false end
+	local result = {[".type"] = data[".type"]}
+	for key, value in pairs(data) do
+		if key:sub(1, 1) ~= "." then result[key] = copy_value(value) end
+	end
+	return result
+end
+
+local function changed_fields(before, after)
+	local keys = {}
+	for key in pairs(before) do
+		if key:sub(1, 1) ~= "." and not equal_value(before[key], after[key]) then keys[key] = true end
+	end
+	for key in pairs(after) do
+		if key:sub(1, 1) ~= "." and not equal_value(before[key], after[key]) then keys[key] = true end
+	end
+	return keys
+end
+
+local function restart_service()
+	local ok, status = pcall(luci.sys.call, "/etc/init.d/" .. name .. " restart > /dev/null 2>&1")
+	return ok and status == 0
+end
