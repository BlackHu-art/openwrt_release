+
+local function finish_subscription(code)
+	local delta = uci_state_dir .. "/" .. name
+	if nixio.fs.access(delta) and not nixio.fs.remove(delta) then
+		print("could not clean private subscription UCI delta")
+		code = 1
+	end
+	if not nixio.fs.remove(uci_state_dir) then
+		print("could not clean private subscription UCI state directory")
+		code = 1
+	end
+	subscription_lock:close()
+	os.exit(code)
+end
+
+local function shared_uci_changes()
+	local cursor = native_uci.cursor()
+	local changes = cursor:changes(name)
+	cursor:unload(name)
+	return type(changes) ~= "table" or next(changes[name] or {}) ~= nil
+end
+
+-- Only these three convenience methods are added to a native libuci cursor.
+local function subscription_cursor()
+	local raw = native_uci.cursor(nil, uci_state_dir)
+	local cursor = {}
+	for _, method in ipairs({"get", "get_all", "foreach", "add", "set", "delete", "commit", "unload"}) do
+		cursor[method] = function(self, ...) return raw[method](raw, ...) end
+	end
+	function cursor:get_first(config, kind, option, default)
+		local result, found
+		raw:foreach(config, kind, function(section)
+			if not found then
+				found = true
+				if option then result = section[option] else result = section[".name"] end
+			end
+			return false
+		end)
+		if result == nil then return default end
+		return result
+	end
+	function cursor:tset(config, sid, values)
+		for key, value in pairs(values) do
+			if key:sub(1, 1) ~= "." and not raw:set(config, sid, key, value) then return false end
+		end
+		return true
+	end
+	function cursor:section(config, kind, sid, values)
+		if sid then
+			if not raw:set(config, sid, kind) then return nil end
+		else
+			sid = raw:add(config, kind)
+		end
+		if not sid or (values and not self:tset(config, sid, values)) then return nil end
+		return sid
+	end
+	return cursor
+end
+
+if shared_uci_changes() then
+	print("subscription refused: shared UCI changes are pending")
+	finish_subscription(1)
+end
