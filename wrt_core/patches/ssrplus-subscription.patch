+local native_uci = require "uci"
+local uci_state_dir = (luci.sys.exec("mktemp -d /tmp/ssr-subscribe.XXXXXX") or ""):match("^(/tmp/ssr%-subscribe%.[%w]+)%s*$")
+if not uci_state_dir then
+	subscription_lock:close()
+	print("could not create private subscription UCI state directory")
+	os.exit(1)
