+-- Reuse a SID only for a one-to-one match of the exact historical native SS
+-- payload hash within its subscription group. Validate the entire plan before
+-- staging UCI writes, including collisions with already-correct current nodes.
+local function native_reference_migrations(pending_md5)
+	local candidates, migrations, owners = {}, {}, {}
+	for _, group in ipairs(nodeResult) do
+		for _, node in ipairs(group) do
+			local identity = legacy_native_identity[node]
+			if identity then
+				local group_hash = node.grouphashkey
+				candidates[group_hash] = candidates[group_hash] or {}
+				local group_candidates = candidates[group_hash]
+				group_candidates[identity.hash] = group_candidates[identity.hash] or {}
+				tinsert(group_candidates[identity.hash], node)
+			end
+		end
+	end
+	ucic:foreach(name, uciType, function(old)
+		local group_hash = old.grouphashkey
+		if group_hash and old.hashkey and pending_md5[group_hash] then
+			local exact = cache[group_hash] and cache[group_hash][old.hashkey]
+			local legacy = candidates[group_hash] and candidates[group_hash][old.hashkey]
+			local node = exact
+			if legacy then
+				checked(#legacy == 1 and not exact, "ambiguous legacy native SS identity")
+				node = legacy[1]
+				local identity = legacy_native_identity[node]
+				checked((old.type == "ss-rust" or old.type == "ss-libev") and
+					old.password == identity.password, "legacy native SS credential identity changed")
+				for _, field in ipairs({"type", "server", "server_port", "encrypt_method_ss", "alias"}) do
+					checked(old[field] == node[field], "legacy native SS identity changed: " .. field)
+				end
+				migrations[old[".name"]] = node
+			end
+			if node then
+				local owner = owners[node]
+				checked(not owner or (not legacy and not owner.legacy),
+					"multiple old SIDs compete for one subscription node")
+				owners[node] = {legacy = legacy ~= nil}
+			end
+		end
+	end)
+	return migrations
+end
